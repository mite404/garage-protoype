{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "garage-prototype",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "APP_ORIGIN": "https://garage-prototype.ethana2008.workers.dev",
    "POSTHOG_ENABLED": "true",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "NEXT_PUBLIC_POSTHOG_ENABLED": "false",
    "NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED": "false",
    "GROWTH_DELIVERY_MODE": "disabled",
    "GROWTH_ANALYSIS_ENABLED": "false",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Existing staging database connection, with caching disabled for access revocation.
      "id": "7dff9d9c8482407589616fb3be60cf9d",
      "localConnectionString": "postgresql://signal_desk_runtime@127.0.0.1:5432/signal_desk",
    },
  ],
  // Typed RPC to the owner Worker, which needs no token, unlike its HTTP route for Node.
  "services": [
    {
      "binding": "STREAM_OWNER",
      "service": "garage-prototype-worker",
      "entrypoint": "StreamOwner",
    },
  ],
  // Branch previews from `wrangler preview` inherit none of the production settings above. They
  // get no database, owner or secrets, so they cannot reach staging data, and every outbound path
  // stays off. Mutations are refused without APP_ORIGIN.
  "previews": {
    "vars": {
      "POSTHOG_ENABLED": "false",
      "NEXT_PUBLIC_POSTHOG_ENABLED": "false",
      "NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED": "false",
      "GROWTH_DELIVERY_MODE": "disabled",
      "GROWTH_ANALYSIS_ENABLED": "false",
    },
  },
  "placement": { "region": "aws:us-west-2" },
  "observability": { "enabled": true },
  // Authenticated desk pages need well over the default per-request CPU; Paid allows 30 s.
  "limits": { "cpu_ms": 30000 },
}
