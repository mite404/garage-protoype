{
  "name": "@signal-desk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudflare && tsc --noEmit -p cloudflare/tsconfig.node.json",
    "worker": "node --env-file-if-exists=../../.env.local --conditions=react-server --import tsx src/worker.ts",
    "mcp": "node --env-file-if-exists=../../.env.local --conditions=react-server --import tsx src/mcp.ts",
    "streaming": "node --env-file-if-exists=../../.env.local --conditions=react-server --import tsx src/streaming-worker.ts",
    "cloudflare:dev": "cd cloudflare && vite dev",
    "cloudflare:build": "cd cloudflare && vite build",
    "cloudflare:deploy": "cd cloudflare && vite build && wrangler deploy",
    "eval:latency": "node --env-file-if-exists=../../.env.local --conditions=react-server --import tsx src/eval/turn-latency.ts",
    "eval:latency:control": "node --env-file-if-exists=../../.env.local --conditions=react-server --import tsx src/eval/provider-control.ts",
    "eval:jev": "node --conditions=react-server --import tsx scripts/eval-jev-routing.ts",
    "eval:extraction": "node --conditions=react-server --import tsx src/extraction-eval.ts",
    "build:cloudflare": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@flue/postgres": "2.3.0",
    "@flue/runtime": "2.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@signal-desk/catalog": "0.1.0",
    "@signal-desk/contracts": "0.1.0",
    "@signal-desk/ui": "0.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "@typesafe-ai/sdk": "0.7.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "unpdf": "1.9.0",
    "valibot": "1.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@flue/vite": "2.3.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@signal-desk/config": "0.1.0",
    "@types/pg": "8.23.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
