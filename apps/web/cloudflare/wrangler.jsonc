{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "garage-prototype-worker",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "POSTHOG_ENABLED": "true",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "GROWTH_DELIVERY_MODE": "disabled",
    "GROWTH_ANALYSIS_ENABLED": "false",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Existing staging connection; caching stays disabled for access revocation.
      "id": "7dff9d9c8482407589616fb3be60cf9d",
      // Local dev; the guarantee suite overrides it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgresql://signal_desk_runtime@127.0.0.1:5432/signal_desk",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TURN_DRIVER", "class_name": "TurnDriver" },
      { "name": "TURN_SWEEPER", "class_name": "TurnSweeper" },
    ],
  },
  // Import jobs, consumed one at a time; the database lease decides who processes a job.
  "queues": {
    "producers": [{ "binding": "IMPORTS", "queue": "signal-desk-imports-staging" }],
    "consumers": [
      { "queue": "signal-desk-imports-staging", "max_batch_size": 1, "max_retries": 10 },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueSpecialistStreamAgent", "TurnDriver", "TurnSweeper"],
    },
  ],
  // Runs the kick handler near the database; Durable Objects take a location hint instead.
  "placement": { "region": "aws:us-west-2" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
