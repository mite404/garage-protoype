# Separate prototype project only. Never use Garage's project or credentials.
# Growth integrations remain off until separately authorized. See docs/growth-integrations.md.
GROWTH_DELIVERY_MODE=disabled
GROWTH_ANALYSIS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
GROWTH_TEST_ALLOWLIST=
GROWTH_FORMS_CONFIG=
GOOGLE_FORMS_ACCESS_TOKEN=
GROWTH_FORMS_INVITATION_URL=
GROWTH_FORMS_REFERENCE_ENTRY=
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Next.js-style aliases are also accepted. Only publishable values may use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Runtime role with explicitly granted private-schema access, not postgres.
DATABASE_URL=
# Operator-only DDL connection. Never used by the running application.
MIGRATION_DATABASE_URL=
# Server-only OpenRouter credential for the admitted Flue provider. Never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Optional telemetry. Disabled until explicitly configured. See docs/posthog.md.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Server-only random salt, at least 32 characters. Never NEXT_PUBLIC_.
POSTHOG_ID_SALT=
# Browser diagnostics require both build-time configuration and per-visit consent.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED=false
# Operator-only provisioning inputs. Remove password after provisioning.
INVITE_EMAIL=
INVITE_PASSWORD=
INVITE_ROLE=buyer
