{
  "name": "signal-desk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@signal-desk/web",
    "build": "turbo run build --concurrency=1",
    "start": "npm run start -w @signal-desk/web --",
    "storybook": "turbo run dev --filter=@signal-desk/storybook",
    "build-storybook": "turbo run build --filter=@signal-desk/storybook",
    "test": "node scripts/test.mjs",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "prepare": "lefthook install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check:docs": "node scripts/check-docs.mjs",
    "fallow": "fallow audit --format json --quiet",
    "check": "npm run check:docs && npm run format:check && npm run lint && npm run typecheck && npm test && npm run fallow",
    "worker": "npm run worker -w @signal-desk/web",
    "mcp": "npm run mcp -w @signal-desk/web",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed:municipality": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-municipality.ts",
    "identity:provision": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/provision.ts",
    "streaming": "npm run streaming -w @signal-desk/web",
    "test:e2e": "e2e run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.2",
    "@flue/cli": "2.3.0",
    "@signal-desk/config": "0.1.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.143",
    "e2e": "0.21.2",
    "fallow": "3.33.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "valibot": "1.5.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.9"
}
