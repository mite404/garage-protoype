{
  "name": "signal-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check:docs": "node scripts/check-docs.mjs",
    "fallow": "fallow audit --format json --quiet",
    "check": "npm run check:docs && npm run format:check && npm run lint && npm run typecheck && npm test && npm run fallow",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "identity:provision": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/provision.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fallow": "3.33.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
